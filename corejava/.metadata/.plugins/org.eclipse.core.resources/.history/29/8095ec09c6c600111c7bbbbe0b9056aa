
public class Studentclass {
	
	
	int stid;
	String sname;
	int marks;
	String cname;
	String clgname;
	String pname;
	
	
	
	
    void studentDisplay() {
    	System.out.println("------------------------------------------");
		System.out.println(stid);
		System.out.println(sname);
		System.out.println(marks);
		System.out.println(cname);
		System.out.println("------------------------------------------");
	}
    
	
    void collegeDetails() {
    	System.out.println("------------------------------------------");
    	System.out.println(clgname);
    	System.out.println(pname);
    	System.out.println("------------------------------------------");
    }
	
	static void changePrincipalNAme() {
		pname="newXYz";
		System.out.println(pname);
		
	}
	public static void main(String[] args) {
 
		Studentclass sc=new Studentclass();
		sc.stid=1;
		sc.sname="Mahesh";
		sc.marks=100;
		sc.clgname="GNU";
		sc.cname="CSE";
		sc.pname="Narayana";
		
		sc.studentDisplay();
		sc.collegeDetails();
		changePrincipalNAme();
		
		
		
		
	}

}

